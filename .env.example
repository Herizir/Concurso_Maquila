# Copiar este archivo como .env y ajustar los valores.
# El .env NO se sube a git (ya esta en .gitignore).

SECRET_KEY=pon-aqui-una-cadena-larga-y-aleatoria

DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=ConcursoMaquila

# Autenticacion de Windows (recomendado en local): dejar en 1
DB_TRUSTED_CONNECTION=1

# Si usas usuario de SQL Server, pon DB_TRUSTED_CONNECTION=0 y llena esto:
DB_USER=
DB_PASSWORD=
